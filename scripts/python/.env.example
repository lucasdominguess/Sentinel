# Configurações específicas do coletor Python.
#
# As credenciais de BANCO são lidas do .env do Laravel (raiz do projeto),
# então NÃO precisam ser repetidas aqui.
#
# Este arquivo guarda apenas o que é específico do coletor.
# Copie para ".env" e preencha quando for usar o Telegram.

# Telegram (opcional — usado quando o coletor enviar notificações)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
